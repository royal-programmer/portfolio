# Environment variables — TEMPLATE ONLY (no real values here).
#
# Copy this file to `.env.local` (gitignored) and fill in the real values for
# local dev. For production, set the same variables in Vercel → Project →
# Settings → Environment Variables.
#
# RULE: anything prefixed NEXT_PUBLIC_ is shipped to the browser. Never put a
# secret behind that prefix. The service-role key is server-only.

# ---- Supabase (Project Settings → API) --------------------------------------
# Public: safe in the browser BECAUSE Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_,
# never log it, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site / domains (D31) ----------------------------------------------------
# Root domain whose subdomains map to personas (code. trade. lens. play. ride.
# art.) — see lib/site/hosts.ts and proxy.ts. Leave empty until the domain is
# live. In dev the mirror `ratulroy.localhost:3000` (hub) and
# `code.ratulroy.localhost:3000` etc. always work regardless.
NEXT_PUBLIC_ROOT_DOMAIN=

# ---- Added in later phases --------------------------------------------------
# Media storage (Cloudflare R2 / Cloudinary), email (Resend), etc. will be
# appended here as those features land.

# ---- GitHub stats (optional) ------------------------------------------------
# SECRET - server-only, never prefix with NEXT_PUBLIC_, never log or commit it.
# The terminal stats command reads the GitHub year through /api/github/contributions. With a
# token it uses the GraphQL API; without one it falls back to the public contributions page.
# A classic PAT with no scopes, or a fine-grained read-only public token, is enough.
GITHUB_TOKEN=

# ---- Admin host + Cloudflare Access (optional, round 33) ------------------------
# The admin is served at admin.<root> (admin.ratulroy.localhost locally). ADMIN_HOST_LABEL changes the
# label, or `apex` keeps the console at <root>/admin. ADMIN_HOST_STRICT=1 redirects /admin to the
# admin host in dev too. When BOTH Cloudflare vars are set, every admin request and server action must
# carry a valid Cf-Access-Jwt-Assertion; leave them empty and nothing changes. See
# docs/claude-planning/16-admin-console.md section 8. Not secrets, but keep the AUD out of the repo.
ADMIN_HOST_LABEL=
ADMIN_HOST_STRICT=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
